            <div class="jawaban-box"><textarea id="refleksi1" placeholder="Tulis jawaban di sini..." rows="3"></textarea></div>
        </div>
        <div class="pertanyaan">
            <div class="pertanyaan-label"><span class="pertanyaan-num">2</span><span>Apakah dugaan/hipotesis awal kelompokmu pada Sintaks 2 terbukti benar setelah melakukan eksplorasi? Jelaskan alasannya!</span></div>
            <div class="jawaban-box"><textarea id="refleksi2" placeholder="Tulis jawaban di sini..." rows="3"></textarea></div>
        </div>
    </div>

    <!-- KIRIM -->
    <div class="send-box">
        <div class="send-box-title">📤 Kirim Jawaban ke Guru</div>
        <p>Setelah semua terisi, kirim ringkasan jawabanmu melalui WhatsApp atau Email. Pastikan guru sudah menerima konfirmasi.</p>
        <div class="btn-group" style="margin:0;">
            <button class="btn btn-wa" onclick="kirimWhatsApp()">💬 Kirim via WhatsApp</button>
            <button class="btn btn-email" onclick="kirimEmail()">📧 Kirim via Email</button>
        </div>
    </div>

</div>

<div class="autosave-pill" id="autosavePill">✅ Tersimpan otomatis</div>

<div class="action-bar">
    <button class="btn btn-success btn-sm" onclick="simpanData()">💾 <span class="btn-label">Simpan</span></button>
    <button class="btn btn-primary btn-sm" onclick="muatData()">📂 <span class="btn-label">Muat</span></button>
    <button class="btn btn-danger btn-sm" onclick="hapusData()">🗑️ <span class="btn-label">Hapus</span></button>
    <button class="btn btn-accent btn-sm" onclick="window.print()">🖨️ <span class="btn-label">Cetak PDF</span></button>
</div>

<script>
    // ==================== STATE ====================
    let jenisKelompok = '';

    // ==================== GROUP SELECTOR ====================
    function pilihKelompok(jenis) {
        jenisKelompok = jenis;
        document.getElementById('jenisKelompokDisplay').value = jenis === 'genap' ? 'GENAP (GLB)' : 'GANJIL (GLBB)';
        document.getElementById('sectionGLB').classList.add('hidden');
        document.getElementById('sectionGLBB').classList.add('hidden');
        if (jenis === 'genap') document.getElementById('sectionGLB').classList.remove('hidden');
        else if (jenis === 'ganjil') document.getElementById('sectionGLBB').classList.remove('hidden');
        localStorage.setItem('eLKPD_jenisKelompok_v6', jenis);
        document.getElementById('groupOverlay').classList.add('hidden');
        updateProgress();
        autoSave();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ==================== KONFIRMASI GANTI KELOMPOK ====================
    function konfirmasiGantiKelompok() {
        const adaJawaban = cekAdaJawaban();
        let pesan = '🔄 Yakin ingin mengganti jenis kelompok?';
        if (adaJawaban) {
            pesan = '⚠️ PERHATIAN!\n\n' +
                    'Kamu sudah mengisi beberapa jawaban pada bagian eksplorasi.\n\n' +
                    'Jika ganti kelompok:\n' +
                    '• Jawaban bagian lama akan DISEMBUNYIKAN\n' +
                    '• Jawaban TETAP TERSIMPAN (tidak hilang)\n' +
                    '• Kamu bisa mengisi bagian eksplorasi baru\n' +
                    '• Bisa balik lagi ke kelompok lama kapan saja\n\n' +
                    'Yakin ingin mengganti jenis kelompok?';
        }
        if (confirm(pesan)) {
            gantiKelompok();
        }
    }

    function cekAdaJawaban() {
        const textareas = document.querySelectorAll('#sectionGLB textarea, #sectionGLBB textarea');
        for (let ta of textareas) {
            if (ta.value && ta.value.trim() !== '') return true;
        }
        const inputs = document.querySelectorAll('#sectionGLB input, #sectionGLBB input');
        for (let inp of inputs) {
            if (inp.value && inp.value.trim() !== '' && inp.type !== 'file') return true;
        }
        return false;
    }

    function gantiKelompok() {
        document.getElementById('sectionGLB').classList.add('hidden');
        document.getElementById('sectionGLBB').classList.add('hidden');
        jenisKelompok = '';
        document.getElementById('jenisKelompokDisplay').value = '';
        document.getElementById('groupOverlay').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        autoSave();
    }

    // ==================== RESET TABEL ====================
    function resetGLB1() {
        for (let i = 1; i <= 5; i++) {
            document.getElementById(`glb1_x${i}`).value = '';
            document.getElementById(`glb1_dx${i}`).value = '';
            document.getElementById(`glb1_v${i}`).value = '';
        }
        autoSave();
    }
    function resetGLB2() {
        for (let i = 1; i <= 3; i++) {
            document.getElementById(`glb2_x${i}`).value = '';
            document.getElementById(`glb2_dx${i}`).value = '';
            document.getElementById(`glb2_vhit${i}`).value = '';
        }
        autoSave();
    }
    function resetGLBB3() {
        for (let i = 1; i <= 5; i++) {
            document.getElementById(`glbb3_v${i}`).value = '';
            document.getElementById(`glbb3_dv${i}`).value = '';
            document.getElementById(`glbb3_a${i}`).value = '';
            document.getElementById(`glbb3_x${i}`).value = '';
            document.getElementById(`glbb3_dx${i}`).value = '';
        }
        autoSave();
    }
    function resetGLBB4() {
        for (let i = 1; i <= 4; i++) {
            document.getElementById(`glbb4_v${i}`).value = '';
            document.getElementById(`glbb4_x${i}`).value = '';
            document.getElementById(`glbb4_dx${i}`).value = '';
        }
        autoSave();
    }

    // ==================== UPLOAD FOTO ====================
    function previewImage(input, previewId, storageKey) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            if (file.size > 3 * 1024 * 1024) {
                alert('⚠️ Ukuran foto terlalu besar (max 3MB). Silakan kompres terlebih dahulu.');
                input.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById(previewId);
                const img = preview.querySelector('img');
                img.src = e.target.result;
                preview.style.display = 'block';
                try {
                    localStorage.setItem(storageKey, e.target.result);
                } catch (err) {
                    console.warn('Gagal simpan foto:', err);
                }
                autoSave();
            };
            reader.readAsDataURL(file);
        }
    }

    function hapusFoto(previewId, inputId, storageKey) {
        if (!confirm('Hapus foto ini?')) return;
        document.getElementById(previewId).style.display = 'none';
        document.getElementById(inputId).value = '';
        localStorage.removeItem(storageKey);
        autoSave();
    }

    ['uploadAreaGLB', 'uploadAreaGLBB'].forEach(id => {
        const area = document.getElementById(id);
        if (!area) return;
        ['dragenter', 'dragover'].forEach(evt => {
            area.addEventListener(evt, e => { e.preventDefault(); area.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(evt => {
            area.addEventListener(evt, e => { e.preventDefault(); area.classList.remove('dragover'); });
        });
        area.addEventListener('drop', e => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const input = area.querySelector('input[type="file"]');
                input.files = files;
                input.dispatchEvent(new Event('change'));
            }
        });
    });

    // ==================== AUTO-SAVE ====================
    function autoSave() {
        const data = {};
        document.querySelectorAll('input, textarea, select').forEach(el => {
            if (el.id && el.type !== 'file') data[el.id] = el.value;
        });
        data['jenisKelompok'] = jenisKelompok;
        const fotoGLB = localStorage.getItem('fotoGLB');
        if (fotoGLB) data['fotoGLB'] = fotoGLB;
        const fotoGLBB = localStorage.getItem('fotoGLBB');
        if (fotoGLBB) data['fotoGLBB'] = fotoGLBB;
        try {
            localStorage.setItem('eLKPD_kinematika_v6', JSON.stringify(data));
        } catch (err) { console.warn('Auto-save gagal:', err); }
        showAutosavePill();
        updateProgress();
    }

    let autosaveTimer;
    function showAutosavePill() {
        const pill = document.getElementById('autosavePill');
        pill.classList.add('show');
        clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(() => pill.classList.remove('show'), 1500);
    }

    document.addEventListener('input', e => {
        if (e.target.matches('input, textarea, select') && e.target.type !== 'file') autoSave();
    });
    document.addEventListener('change', e => {
        if (e.target.matches('input, textarea, select') && e.target.type !== 'file') autoSave();
    });

    // ==================== PROGRESS ====================
    function updateProgress() {
        const allFields = document.querySelectorAll('input[type="text"], input[type="number"], input[type="date"], textarea, select');
        let filled = 0, total = 0;
        allFields.forEach(el => {
            if (el.readOnly || el.disabled) return;
            total++;
            if (el.value && el.value.trim() !== '') filled++;
        });
        const pct = total > 0 ? Math.round((filled / total) * 100) : 0;
        document.getElementById('progressFill').style.width = pct + '%';
        document.getElementById('progressText').textContent = pct + '%';
    }

    // ==================== SIMPAN / MUAT / HAPUS ====================
    function simpanData() {
        autoSave();
        alert('✅ Jawaban berhasil disimpan!');
    }

    function muatData() {
        const saved = localStorage.getItem('eLKPD_kinematika_v6');
        if (!saved) { alert('❌ Tidak ada data tersimpan.'); return; }
        const data = JSON.parse(saved);
        Object.keys(data).forEach(key => {
            if (key === 'jenisKelompok') {
                if (data[key] && !jenisKelompok) pilihKelompok(data[key]);
                return;
            }
            if (key === 'fotoGLB' || key === 'fotoGLBB') {
                const previewId = key === 'fotoGLB' ? 'previewGLB' : 'previewGLBB';
                const preview = document.getElementById(previewId);
                if (preview && data[key]) {
                    preview.querySelector('img').src = data[key];
                    preview.style.display = 'block';
                }
                return;
            }
            const el = document.getElementById(key);
            if (el) el.value = data[key];
        });
        updateProgress();
    }

    function hapusData() {
        if (confirm('⚠️ Yakin ingin menghapus SEMUA jawaban? Tindakan ini tidak dapat dibatalkan.')) {
            ['eLKPD_kinematika_v6', 'eLKPD_jenisKelompok_v6', 'fotoGLB', 'fotoGLBB'].forEach(k => localStorage.removeItem(k));
            alert('🗑️ Data dihapus. Halaman akan dimuat ulang.');
            location.reload();
        }
    }

    // ==================== KIRIM KE GURU ====================
    function getRingkasan() {
        const nama = document.getElementById('namaKelompok').value || '(belum diisi)';
        const jenis = document.getElementById('jenisKelompokDisplay').value || '(belum dipilih)';
        const anggota = [
            document.getElementById('anggota1').value,
            document.getElementById('anggota2').value,
            document.getElementById('anggota3').value,
            document.getElementById('anggota4').value,
            document.getElementById('anggota5').value,
            document.getElementById('anggota6').value
        ].filter(a => a).join(', ');

        let r = `*E-LKPD KINEMATIKA GLB & GLBB*\n`;
        r += `━━━━━━━━━━━━━━━━━━━━\n`;
        r += `*Kelompok:* ${nama}\n`;
        r += `*Jenis:* ${jenis}\n`;
        r += `*Anggota:* ${anggota || '-'}\n`;
        r += `━━━━━━━━━━━━━━━━━━━━\n\n`;
        r += `*C. ENGAGE*\n`;
        r += `1. ${document.getElementById('jawabanPemantik1').value || '-'}\n`;
        r += `2. ${document.getElementById('jawabanPemantik2').value || '-'}\n\n`;
        if (jenisKelompok === 'genap') {
            r += `*F. EKSPLORASI GLB*\n`;
            r += `• Tabel 1 diisi oleh: ${document.getElementById('diisiGLB1').value || '-'}\n`;
            r += `• Tabel 2 diisi oleh: ${document.getElementById('diisiGLB2').value || '-'}\n`;
            r += `• Analisis 1: ${document.getElementById('analisisGLB1').value || '-'}\n`;
            r += `• Analisis 2: ${document.getElementById('analisisGLB2').value || '-'}\n`;
            r += `• Analisis 3: ${document.getElementById('analisisGLB3').value || '-'}\n\n`;
        } else if (jenisKelompok === 'ganjil') {
            r += `*G. EKSPLORASI GLBB*\n`;
            r += `• Tabel 3 diisi oleh: ${document.getElementById('diisiGLBB3').value || '-'}\n`;
            r += `• Tabel 4 diisi oleh: ${document.getElementById('diisiGLBB4').value || '-'}\n`;
            r += `• Analisis 1: ${document.getElementById('analisisGLBB1').value || '-'}\n`;
            r += `• Analisis 2: ${document.getElementById('analisisGLBB2').value || '-'}\n`;
            r += `• Analisis 3: ${document.getElementById('analisisGLBB3').value || '-'}\n\n`;
        }
        r += `*H. KOMPARASI GLB vs GLBB*\n`;
        r += `• Δx: GLB=${document.getElementById('komp_dx_glb').value || '-'} | GLBB=${document.getElementById('komp_dx_glbb').value || '-'}\n`;
        r += `• v: GLB=${document.getElementById('komp_v_glb').value || '-'} | GLBB=${document.getElementById('komp_v_glbb').value || '-'}\n`;
        r += `• a: GLB=${document.getElementById('komp_a_glb').value || '-'} | GLBB=${document.getElementById('komp_a_glbb').value || '-'}\n`;
        r += `• Grafik x-t: GLB=${document.getElementById('komp_grafikx_glb').value || '-'} | GLBB=${document.getElementById('komp_grafikx_glbb').value || '-'}\n`;
        r += `• Grafik v-t: GLB=${document.getElementById('komp_grafikv_glb').value || '-'} | GLBB=${document.getElementById('komp_grafikv_glbb').value || '-'}\n`;
        r += `• Grafik a-t: GLB=${document.getElementById('komp_grafika_glb').value || '-'} | GLBB=${document.getElementById('komp_grafika_glbb').value || '-'}\n`;
        r += `• Contoh: GLB=${document.getElementById('komp_contoh_glb').value || '-'} | GLBB=${document.getElementById('komp_contoh_glbb').value || '-'}\n\n`;
        r += `*Kesimpulan Akhir:*\n`;
        r += `1. GLB: v=${document.getElementById('simpulan1a').value || '-'}, a=${document.getElementById('simpulan1b').value || '-'}\n`;
        r += `2. GLBB: a=${document.getElementById('simpulan2a').value || '-'}, v=${document.getElementById('simpulan2b').value || '-'}\n`;
        r += `3. a negatif = ${document.getElementById('simpulan3').value || '-'}\n\n`;
        r += `*I. REFLEKSI*\n`;
        r += `1. ${document.getElementById('refleksi1').value || '-'}\n`;
        r += `2. ${document.getElementById('refleksi2').value || '-'}\n`;
        return r;
    }

    function kirimWhatsApp() {
        const pesan = getRingkasan();
        const noGuru = prompt('📱 Masukkan nomor WhatsApp guru:\n(format: 628xxxxxxxxxx)', '6281234567890');
        if (!noGuru) return;
        window.open(`https://wa.me/${noGuru.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(pesan)}`, '_blank');
    }

    function kirimEmail() {
        const pesan = getRingkasan();
        const emailGuru = prompt('📧 Masukkan alamat email guru:', 'guru@sekolah.sch.id');
        if (!emailGuru) return;
        const subject = `E-LKPD Kinematika - ${document.getElementById('namaKelompok').value || 'Kelompok'}`;
        window.location.href = `mailto:${emailGuru}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(pesan)}`;
    }

    // ==================== INIT ====================
    window.addEventListener('load', function() {
        const savedJenis = localStorage.getItem('eLKPD_jenisKelompok_v6');
        if (savedJenis) {
            pilihKelompok(savedJenis);
        } else {
            document.getElementById('groupOverlay').classList.remove('hidden');
        }
        const savedData = localStorage.getItem('eLKPD_kinematika_v6');
        if (savedData && savedJenis) {
            setTimeout(() => { muatData(); }, 100);
        }
        updateProgress();
    });
</script>

</body>
</html>
